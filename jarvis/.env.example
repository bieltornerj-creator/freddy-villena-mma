# Copia este archivo a .env y rellena tus claves.
# Las claves NUNCA llegan al frontend: solo las usa server.js.

# Obligatoria: tu clave de la API de Anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional pero recomendada: token personal de ClickUp.
# Permite que Jarvis consulte el estado del negocio (digitalbiel).
# Lo generas en: ClickUp → Settings → Apps → API Token (empieza por "pk_").
CLICKUP_API_TOKEN=pk_...

# Opcional. Por defecto 3000.
PORT=3000
